{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["node"],

    // Node runs the .ts files directly by stripping types, so only syntax that
    // erases cleanly, and imports spelled the way Node resolves them
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  // The CodeMirror pane's packages aren't installed (codemirror_pane.ts)
  "exclude": [
    "node_modules",
    "dist",
    "views/markdown/codemirror_pane.ts",
    "views/markdown/merge.ts",
    "views/markdown/merge.test.ts"
  ]
}
