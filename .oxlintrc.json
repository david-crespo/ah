{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [".claude/**"],
  "overrides": [
    {
      "files": ["platform/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/core/**", "**/subjects/**", "**/views/**", "**/cli/**"],
                "message": "platform/ is the bottom layer"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["subjects/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/core/**", "**/views/**", "**/cli/**"],
                "message": "subjects/ is under core/, views/ and cli/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/views/**", "**/cli/**"],
                "message": "core/ is under views/ and cli/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["views/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "group": ["**/cli/**"], "message": "views/ is under cli/" }]
          }
        ]
      }
    }
  ]
}
