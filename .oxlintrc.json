{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["platform/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/core/**", "**/subjects/**", "**/views/**"],
                "message": "platform/ is the bottom layer"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["subjects/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/core/**", "**/views/**"],
                "message": "subjects/ is under core/ and views/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "group": ["**/views/**"], "message": "core/ is under views/" }]
          }
        ]
      }
    }
  ]
}
